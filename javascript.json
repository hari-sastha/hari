  "MCQ Quiz with Score": {
    "prefix": "mcq-quiz",
    "description": "MCQ quiz and score system",
    "body": [
      "/*",
      "<div id=\"quiz\"></div>",
      "<button id=\"submitBtn\">Submit</button>",
      "<p id=\"score\"></p>",
      "*/",
      "",
      "const questions = [",
      "  { question: \"2 + 2?\", options: [\"3\", \"4\", \"5\"], answer: \"4\" },",
      "  { question: \"Capital of France?\", options: [\"Paris\", \"Rome\", \"Berlin\"], answer: \"Paris\" }",
      "];",
      "",
      "const quiz = document.getElementById(\"quiz\");",
      "const submitBtn = document.getElementById(\"submitBtn\");",
      "const scoreEl = document.getElementById(\"score\");",
      "",
      "questions.forEach((q, i) => {",
      "  const div = document.createElement(\"div\");",
      "  div.innerHTML = `<p>${q.question}</p>` +",
      "    q.options.map(o =>",
      "      `<label><input type=\"radio\" name=\"q${i}\" value=\"${o}\" /> ${o}</label><br>`",
      "    ).join(\"\");",
      "  quiz.appendChild(div);",
      "});",
      "",
      "submitBtn.addEventListener(\"click\", () => {",
      "  let score = 0;",
      "  questions.forEach((q, i) => {",
      "    const ans = document.querySelector(`input[name=\"q${i}\"]:checked`);",
      "    if (ans && ans.value === q.answer) score++;",
      "  });",
      "  scoreEl.textContent = `Score: ${score}/${questions.length}`;",
      "});"
    ]
  },

  "Fetch API with Retry": {
    "prefix": "fetch-retry",
    "description": "Fetch API with 3 retries",
    "body": [
      "/*",
      "<button id=\"loadData\">Load</button>",
      "<pre id=\"result\"></pre>",
      "*/",
      "",
      "async function fetchWithRetry(url, retries = 3) {",
      "  try {",
      "    const res = await fetch(url);",
      "    if (!res.ok) throw new Error(\"Failed\");",
      "    return await res.json();",
      "  } catch (err) {",
      "    if (retries > 0) return fetchWithRetry(url, retries - 1);",
      "    throw err;",
      "  }",
      "}",
      "",
      "document.getElementById(\"loadData\").addEventListener(\"click\", async () => {",
      "  const result = document.getElementById(\"result\");",
      "  try {",
      "    const data = await fetchWithRetry(\"https://jsonplaceholder.typicode.com/posts/1\");",
      "    result.textContent = JSON.stringify(data, null, 2);",
      "  } catch {",
      "    result.textContent = \"Failed after 3 attempts\";",
      "  }",
      "});"
    ]
  },
  "Q1 Rate Limiter - Sliding Window": {
    "prefix": "rate-limiter",
    "description": "Smart API Rate Limiter with sliding window logic",
    "body": [
      "/*",
      "<input id=\"userId\" placeholder=\"User ID\" />",
      "<button id=\"requestBtn\">Send Request</button>",
      "<p id=\"output\"></p>",
      "*/",
      "",
      "class RateLimiter {",
      "  constructor(N, T) {",
      "    this.N = N;",
      "    this.T = T;",
      "    this.users = new Map();",
      "  }",
      "",
      "  isAllowed(userId, timestamp) {",
      "    if (!this.users.has(userId)) {",
      "      this.users.set(userId, []);",
      "    }",
      "    const requests = this.users.get(userId);",
      "    while (requests.length && requests[0] <= timestamp - this.T) {",
      "      requests.shift();",
      "    }",
      "    if (requests.length < this.N) {",
      "      requests.push(timestamp);",
      "      return true;",
      "    }",
      "    return false;",
      "  }",
      "}",
      "",
      "const limiter = new RateLimiter(3, 10);",
      "document.getElementById(\"requestBtn\").addEventListener(\"click\", () => {",
      "  const user = document.getElementById(\"userId\").value;",
      "  const allowed = limiter.isAllowed(user, Math.floor(Date.now()/1000));",
      "  document.getElementById(\"output\").textContent = allowed;",
      "});"
    ]
  },

  "Q2 Task Reminder System": {
    "prefix": "task-reminder",
