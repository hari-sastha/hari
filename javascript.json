  "Q4 Data Backup System": {
    "prefix": "data-backup",
    "description": "Backup and restore JSON state",
    "body": [
      "/*",
      "<button id=\"backupBtn\">Backup</button>",
      "<button id=\"restoreBtn\">Restore</button>",
      "*/",
      "",
      "let appState = { name: \"App\", version: 1 };",
      "",
      "document.getElementById(\"backupBtn\").addEventListener(\"click\", () => {",
      "  localStorage.setItem(\"backup\", JSON.stringify(appState));",
      "  console.log(\"Backup created\");",
      "});",
      "",
      "document.getElementById(\"restoreBtn\").addEventListener(\"click\", () => {",
      "  const data = localStorage.getItem(\"backup\");",
      "  try {",
      "    appState = JSON.parse(data);",
      "    console.log(\"State restored\");",
      "  } catch (e) {",
      "    console.error(\"Invalid backup\");",
      "  }",
      "});"
    ]
  },

