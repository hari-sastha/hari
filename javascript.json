  "Q15 Metro Train BFS": {
    "prefix": "metro-bfs",
    "description": "Shortest path with ticket validation",
    "body": [
      "function minSteps(grid) {",
      "  const rows = grid.length;",
      "  const cols = grid[0].length;",
      "  const queue = [];",
      "  const visited = new Set();",
      "",
      "  let start;",
      "  for (let r = 0; r < rows; r++) {",
      "    for (let c = 0; c < cols; c++) {",
      "      if (grid[r][c] === 'S') start = [r, c, false];",
      "    }",
      "  }",
      "",
      "  queue.push([...start, 0]);",
      "",
      "  while (queue.length) {",
      "    const [r, c, ticket, steps] = queue.shift();",
      "    if (grid[r][c] === 'E') return steps;",
      "",
      "    const key = `${r},${c},${ticket}`;",
      "    if (visited.has(key)) continue;",
      "    visited.add(key);",
      "",
      "    for (let [dr, dc] of [[1,0],[-1,0],[0,1],[0,-1]]) {",
      "      const nr = r + dr;",
      "      const nc = c + dc;",
      "      if (nr>=0 && nc>=0 && nr<rows && nc<cols) {",
      "        const cell = grid[nr][nc];",
      "        if (cell === '#') continue;",
      "        if (cell === 'G' && !ticket) continue;",
      "        queue.push([nr, nc, ticket || cell==='T', steps+1]);",
      "      }",
      "    }",
      "  }",
      "  return -1;",
      "}"
    ]
  },

  "Q16 Ultra Simple Shortcut": {
    "prefix": "q16-shortcut",
    "description": "javascript-4 combined HTML + JS (shortcut keys + toggle help)",
    "body": [
      "/*",
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "    <script src=\"index.js\" defer></script>",
      "    <title>Document</title>",
      "</head>",
      "<body>",
      "",
      "<h2>Ultra Simple Shortcut</h2>",
      "",
      "<button id=\"btn\">Help Me!</button>",
      "",
      "<ul id=\"list\">",
      "    <li>Ctrl+s - Data Save</li>",
      "    <li>Ctrl+z - Data undo</li>",
      "    <li>Esc - canvas cleared</li>",
      "</ul>",
      "",
      "<p id=\"output\">Press Ctrl+S or Escape</p>",
      "</body>",
      "</html>",
      "*/",
      "",
      "document.addEventListener(\"keydown\", function(e){",
      "",
      "    // Ctrl + S",
      "    if(e.ctrlKey && e.key.toLowerCase() == \"s\"){",
      "",
      "        e.preventDefault();",
      "",
      "        document.getElementById(\"output\").innerText =",
      "        \"Ctrl+S pressed - Data saved!\";",
      "    }",
      "",
      "    // Escape",
      "    if(e.key == \"Escape\"){",
      "",
      "        document.getElementById(\"output\").innerText =",
      "        \"Esc pressed - Canvas cleared!\";",
      "    }",
      "",
      "    if(e.ctrlKey && e.key.toLowerCase() == \"z\"){",
      "        e.preventDefault();",
      "        document.getElementById(\"output\").innerText = \"Ctrl+Z pressed - operation Undo\"",
      "    }",
      "",
      "});",
      "",
      "var button = document.getElementById(\"btn\");",
      "var ul = document.getElementById(\"list\");",
      "var isOpen = false;",
      "",
      "ul.style.display = \"none\";",
      "",
      "button.addEventListener(\"click\", function(){",
      "    isOpen = !isOpen;",
      "    ul.style.display = isOpen ? \"block\" : \"none\";",
      "});"
    ]
  },

  "Q17 Bank Account": {
    "prefix": "q17-bank-account",
    "description": "javascript-5 combined HTML + JS (deposit/withdraw with log)",
    "body": [
      "/*",
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "    <title>Document</title>",
      "    <link rel=\"stylesheet\" href=\"index.css\">",
      "    <script src=\"index.js\" defer></script>",
      "</head>",
      "<body>",
      "",
      "<div class=\"container\">",
      "",
      "<h2>Bank Account</h2>",
      "",
      "<div id=\"balance\">Balance: ₹0</div>",
      "",
      "<input type=\"number\" id=\"amount\" placeholder=\"Enter amount\">",
      "",
      "<br>",
      "",
      "<button onclick=\"deposit()\">Deposit</button>",
      "",
      "<button onclick=\"withdraw()\">Withdraw</button>",
      "",
      "<div id=\"error\" class=\"error\"></div>",
      "",
      "<h3>Transaction Log</h3>",
      "",
      "<div id=\"log\"></div>",
      "",
      "</div>",
      "",
      "</body>",
      "</html>",
      "*/",
      "",
      "var balance = 0;",
      "",
      "function deposit(){",
      "",
      "    var amt = Number(document.getElementById(\"amount\").value);",
      "",
      "    if(amt <=0){",
      "        document.getElementById(\"error\").innerText = \"invalid amount\";",
      "        document.getElementById(\"amount\").value = \"\";",
      "        return;",
      "    }",
      "",
      "    balance = balance + amt;",
      "",
      "    document.getElementById(\"balance\").innerText=\"Balance: ₹\" + balance;",
      "",
      "    var log = document.getElementById(\"log\");",
      "",
      "    var time = new Date().toLocaleString();",
      "",
      "    var message = \"Deposit ₹\" + amt +",
      "    \" | Balance ₹\" + balance +",
      "    \" | \" + time;",
      "",
      "    var div = document.createElement(\"div\");",
      "",
      "    div.innerText = message;",
      "",
      "  log.prepend(div);",
      "",
      "  document.getElementById(\"error\").innerText = \"\";",
      "",
      "  document.getElementById(\"amount\").value = \"\";",
      "",
      "}",
      "",
      "",
      "function withdraw(){",
      "",
      "    var amt = Number(document.getElementById(\"amount\").value);",
      "",
      "    var min_balance = 100;",
      "",
      "    if(amt <=0){",
      "        document.getElementById(\"error\").innerText = \"invalid amount\";",
      "        document.getElementById(\"amount\").value = \"\";",
      "        return;",
      "    }",
      "    if(amt > balance){",
      "        document.getElementById(\"error\").innerText = \"Um-bu\";",
      "        document.getElementById(\"amount\").value = \"\";",
      "        return;",
      "    }",
      "",
      "    if(balance - amt < min_balance){",
      "        document.getElementById(\"error\").innerText = \"balance should be above 100\";",
      "        document.getElementById(\"amount\").value = \"\";",
      "        return;",
      "    }",
      "",
      "    balance = balance - amt;",
      "",
      "    document.getElementById(\"balance\").innerText=\"Balance: ₹\" + balance;",
      "",
      "    var log = document.getElementById(\"log\");",
      "",
      "    var time = new Date().toLocaleString();",
      "",
      "    var message = \"Deposit ₹\" + amt +",
      "    \" | Balance ₹\" + balance +",
      "    \" | \" + time;",
      "",
      "    var div = document.createElement(\"div\");",
      "",
      "    div.innerText = message;",
      "",
      "  log.prepend(div);",
      "",
      "  document.getElementById(\"error\").innerText = \"\";",
      "",
      "  document.getElementById(\"amount\").value = \"\";",
      "",
      "}"
    ]
  },

  "Q18 Bus Booking System": {
    "prefix": "q18-bus-booking",
    "description": "javascript-6 combined HTML + JS (book up to 6 seats + bill)",
    "body": [
      "/*",
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "\t<meta charset=\"UTF-8\" />",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "\t<title>Bus Booking System (HTML + JS)</title>",
      "</head>",
      "<body>",
      "\t<h1>Bus Booking System</h1>",
      "",
      "\t<p>",
      "\t\tSelect up to <strong>6</strong> seats. Clicking an unavailable seat will show an alert.",
      "\t</p>",
      "",
      "\t<fieldset>",
      "\t\t<legend>Trip</legend>",
      "\t\t<label>",
      "\t\t\tPrice per seat (₹):",
      "\t\t\t<input id=\"pricePerSeat\" type=\"number\" min=\"1\" value=\"250\" />",
      "\t\t</label>",
      "\t\t<button id=\"applyPrice\" type=\"button\">Apply Price</button>",
      "\t</fieldset>",
      "",
      "\t<fieldset>",
      "\t\t<legend>Seats</legend>",
      "\t\t<div id=\"status\"></div>",
      "\t\t<div id=\"seatMap\" aria-label=\"Seat map\"></div>",
      "\t\t<p>",
      "\t\t\tSelected seats: <span id=\"selectedSeats\">None</span>",
      "\t\t</p>",
      "\t\t<button id=\"confirmBooking\" type=\"button\">Confirm Booking</button>",
      "\t\t<button id=\"clearSelection\" type=\"button\">Clear Selection</button>",
      "\t</fieldset>",
      "",
      "\t<fieldset>",
      "\t\t<legend>Bill</legend>",
      "\t\t<div id=\"bill\"></div>",
      "\t</fieldset>",
      "",
      "\t<script src=\"index.js\" defer></script>",
      "</body>",
      "</html>",
      "*/",
      "",
      "(() => {",
      "  \"use strict\";",
      "",
      "  const MAX_SELECTION = 6;",
      "",
      "  // Seat layout: 8 rows x 5 columns = 40 seats",
      "  const ROWS = 8;",
      "  const COLS = 5;",
      "  const ROW_LABELS = \"ABCDEFGH\";",
      "",
      "  // Some seats start as unavailable (already booked)",
      "  const initiallyBooked = new Set([",
      "    \"A2\",",
      "    \"A3\",",
      "    \"B1\",",
      "    \"C4\",",
      "    \"D5\",",
      "    \"F2\",",
      "    \"G3\",",
      "    \"H5\"",
      "  ]);",
      "",
      "  /** @type {Map<string, {id: string, status: 'available'|'unavailable'}>} */",
      "  const seats = new Map();",
      "",
      "  /** @type {Set<string>} */",
      "  const selected = new Set();",
      "",
      "  let pricePerSeat = 250;",
      "",
      "  function seatId(rowIndex, colIndex) {",
      "    return `${ROW_LABELS[rowIndex]}${colIndex + 1}`;",
      "  }",
      "",
      "  function initSeats() {",
      "    seats.clear();",
      "    for (let r = 0; r < ROWS; r++) {",
      "      for (let c = 0; c < COLS; c++) {",
      "        const id = seatId(r, c);",
      "        seats.set(id, {",
      "          id,",
      "          status: initiallyBooked.has(id) ? \"unavailable\" : \"available\"",
      "        });",
      "      }",
      "    }",
      "  }",
      "",
      "  function computeCounts() {",
      "    let available = 0;",
      "    let unavailable = 0;",
      "",
      "    for (const seat of seats.values()) {",
      "      if (seat.status === \"available\") available++;",
      "      else unavailable++;",
      "    }",
      "",
      "    return { available, unavailable };",
      "  }",
      "",
      "  function renderStatus() {",
      "    const statusEl = document.getElementById(\"status\");",
      "    const { available, unavailable } = computeCounts();",
      "",
      "    statusEl.innerHTML = \"\";",
      "    const p = document.createElement(\"p\");",
      "    p.textContent = `Available: ${available} | Unavailable: ${unavailable} | Selected: ${selected.size}/${MAX_SELECTION}`;",
      "    statusEl.appendChild(p);",
      "  }",
      "",
      "  function renderSelected() {",
      "    const selectedEl = document.getElementById(\"selectedSeats\");",
      "    if (selected.size === 0) {",
      "      selectedEl.textContent = \"None\";",
      "      return;",
      "    }",
      "",
      "    selectedEl.textContent = Array.from(selected).sort().join(\", \");",
      "  }",
      "",
      "  function renderBill() {",
      "    const billEl = document.getElementById(\"bill\");",
      "    billEl.innerHTML = \"\";",
      "",
      "    const seatsList = Array.from(selected).sort();",
      "    const qty = seatsList.length;",
      "    const subtotal = qty * pricePerSeat;",
      "",
      "    const pre = document.createElement(\"pre\");",
      "    pre.textContent = [",
      "      \"BUS TICKET BILL\",",
      "      \"----------------\",",
      "      `Selected seats : ${qty ? seatsList.join(\", \") : \"None\"}` ,",
      "      `Price/seat     : ₹${pricePerSeat}`,",
      "      `Total seats    : ${qty}`,",
      "      `Total amount   : ₹${subtotal}`",
      "    ].join(\"\\n\");",
      "",
      "    billEl.appendChild(pre);",
      "  }",
      "",
      "  function seatButtonLabel(seat) {",
      "    if (seat.status === \"unavailable\") return `${seat.id} (Booked)`;",
      "    if (selected.has(seat.id)) return `${seat.id} (Selected)`;",
      "    return seat.id;",
      "  }",
      "",
      "  function renderSeatMap() {",
      "    const mapEl = document.getElementById(\"seatMap\");",
      "    mapEl.innerHTML = \"\";",
      "",
      "    const table = document.createElement(\"table\");",
      "    table.setAttribute(\"border\", \"1\");",
      "    table.setAttribute(\"cellpadding\", \"8\");",
      "    table.setAttribute(\"aria-label\", \"Bus seats\");",
      "",
      "    const caption = document.createElement(\"caption\");",
      "    caption.textContent = \"Click a seat to select/deselect\";",
      "    table.appendChild(caption);",
      "",
      "    for (let r = 0; r < ROWS; r++) {",
      "      const tr = document.createElement(\"tr\");",
      "",
      "      for (let c = 0; c < COLS; c++) {",
      "        const td = document.createElement(\"td\");",
      "        const id = seatId(r, c);",
      "        const seat = seats.get(id);",
      "",
      "        const btn = document.createElement(\"button\");",
      "        btn.type = \"button\";",
      "        btn.dataset.seatId = id;",
      "        btn.textContent = seatButtonLabel(seat);",
      "        btn.title = seat.status === \"unavailable\" ? \"Unavailable seat\" : \"Available seat\";",
      "",
      "        btn.addEventListener(\"click\", () => onSeatClick(id));",
      "",
      "        td.appendChild(btn);",
      "        tr.appendChild(td);",
      "      }",
      "",
      "      table.appendChild(tr);",
      "    }",
      "",
      "    mapEl.appendChild(table);",
      "  }",
      "",
      "  function rerenderAll() {",
      "    renderStatus();",
      "    renderSeatMap();",
      "    renderSelected();",
      "    renderBill();",
      "  }",
      "",
      "  function onSeatClick(id) {",
      "    const seat = seats.get(id);",
      "    if (!seat) return;",
      "",
      "    if (seat.status === \"unavailable\") {",
      "      alert(`Seat ${id} is already booked. Please choose another seat.`);",
      "      return;",
      "    }",
      "",
      "    if (selected.has(id)) {",
      "      selected.delete(id);",
      "      rerenderAll();",
      "      return;",
      "    }",
      "",
      "    if (selected.size >= MAX_SELECTION) {",
      "      alert(`You can book only up to ${MAX_SELECTION} seats.`);",
      "      return;",
      "    }",
      "",
      "    selected.add(id);",
      "    rerenderAll();",
      "  }",
      "",
      "  function confirmBooking() {",
      "    if (selected.size === 0) {",
      "      alert(\"Select at least 1 seat to confirm.\");",
      "      return;",
      "    }",
      "",
      "    for (const id of selected) {",
      "      const seat = seats.get(id);",
      "      if (seat) seat.status = \"unavailable\";",
      "    }",
      "",
      "    selected.clear();",
      "    rerenderAll();",
      "    alert(\"Booking confirmed!\");",
      "  }",
      "",
      "  function clearSelection() {",
      "    selected.clear();",
      "    rerenderAll();",
      "  }",
      "",
      "  function applyPrice() {",
      "    const input = document.getElementById(\"pricePerSeat\");",
      "    const nextPrice = Number(input.value);",
      "",
      "    if (!Number.isFinite(nextPrice) || nextPrice <= 0) {",
      "      alert(\"Enter a valid price per seat.\");",
      "      input.value = String(pricePerSeat);",
      "      return;",
      "    }",
      "",
      "    pricePerSeat = Math.floor(nextPrice);",
      "    input.value = String(pricePerSeat);",
      "    renderBill();",
      "  }",
      "",
      "  function wireUI() {",
      "    document.getElementById(\"confirmBooking\").addEventListener(\"click\", confirmBooking);",
      "    document.getElementById(\"clearSelection\").addEventListener(\"click\", clearSelection);",
      "    document.getElementById(\"applyPrice\").addEventListener(\"click\", applyPrice);",
      "  }",
      "",
      "  document.addEventListener(\"DOMContentLoaded\", () => {",
      "    initSeats();",
      "    wireUI();",
      "    rerenderAll();",
      "  });",
      "})();"
    ]
  }

}
